# Copy this file to .env (it is gitignored) and fill it in.

PORT=8080

# Websites allowed to call the API from a browser, comma separated.
CORS_ORIGINS=http://localhost:5173,https://rickysalimart.web.app

# Image hosting. Cloudinary dashboard > Settings > API Keys > copy "API environment variable".
CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME

# LOCAL: absolute path to your service account key file (no ~ and no quotes).
GOOGLE_APPLICATION_CREDENTIALS=/Users/YOUR_NAME/keys/rickysalimart-key.json

# HOSTED (e.g. Render): instead of the line above, set this in the host's
# dashboard to the whole key file as JSON. Never commit it.
# FIREBASE_SERVICE_ACCOUNT=
