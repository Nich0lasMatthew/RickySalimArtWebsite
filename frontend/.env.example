# Copy to .env.local (gitignored) and fill in from
# Firebase console > Project settings > Your apps > Web app > SDK setup and configuration.
# These identify your project; they are not secrets (security comes from the API
# checking tokens and from the locked Firestore/Storage rules).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=rickysalimart.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=rickysalimart
VITE_FIREBASE_APP_ID=

# Where the backend API lives in production, e.g. https://rickysalimart-api.onrender.com
# Leave empty in development (Vite forwards /api to localhost:8080).
VITE_API_URL=

# Optional: the portrait's Storage URL printed by `pnpm upload-images`.
VITE_PORTRAIT_URL=
