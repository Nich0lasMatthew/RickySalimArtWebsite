rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Browsers never talk to Firestore directly: all reads and writes go
    // through the backend API, which uses the Admin SDK (that bypasses these
    // rules). So everything is locked for client access.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
